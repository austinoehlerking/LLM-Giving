Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(assets/(app\.css|library\.css|app\.js|ai-selection\.js|analytics\.js|submission\.css|submission\.js|receipt\.css|receipt\.js|request-setup\.js|workflow\.css|workflow\.js|blog\.css|forks\.css|artifacts\.css|artifacts\.js|home-hero\.css|home-hero\.js|research-community\.webp|llm-giving-social-v1\.jpg)|favicon\.svg)$ - [L]
RewriteRule ^ index.php [QSA,L]
