Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(assets/(app\.css|library\.css|app\.js|submission\.css|submission\.js|request-setup\.js|workflow\.css|workflow\.js|blog\.css|artifacts\.css|artifacts\.js|home-hero\.css|home-hero\.js|research-community\.webp)|favicon\.svg)$ - [L]
RewriteRule ^ index.php [QSA,L]
